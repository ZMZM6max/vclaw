<?xml version="1.0" encoding="UTF-8"?>
<!--
  L5 Component: BashAnalyzer
  所属层: L5 - 能力抽象层 (Tools &amp; Capabilities)
  创建时间: 2024
  用途: 详细定义Bash命令分析器组件的架构、风险分类、危险模式识别与安全评估机制
-->
<ComponentSpec id="L5-BASH-ANALYZER" name="BashAnalyzer" layer="L5" version="1.0">

  <!-- ==================== 1. 基本信息 ==================== -->
  <Overview>
    <Description>Bash命令分析器，对终端命令进行风险分类和安全评估。负责将Bash命令分类为SAFE/READ/WRITE/NETWORK/EXEC等类型，评估风险等级（minimal到critical），识别危险模式（如rm -rf、管道到shell等）。BashAnalyzer是L5层终端命令安全的第一道防线，为ConfirmationManager和ToolExecutor提供决策依据。</Description>
    <Role>L5层终端命令安全评估引擎</Role>
    <Responsibility>命令分类、风险评级、危险模式识别、安全建议生成</Responsibility>
  </Overview>

  <!-- ==================== 2. 核心职责 ==================== -->
  <Responsibilities>
    <Item priority="critical">将Bash命令分类为 SAFE / READ / WRITE / NETWORK / EXEC</Item>
    <Item priority="critical">评估命令风险等级（minimal / low / medium / high / critical）</Item>
    <Item priority="high">识别危险模式（如 rm -rf、管道到shell、远程代码执行等）</Item>
    <Item priority="high">生成安全建议（替代方案或风险提示）</Item>
    <Item priority="medium">命令结构解析（管道、重定向、子shell等）</Item>
    <Item priority="medium">维护危险命令特征库</Item>
  </Responsibilities>

  <!-- ==================== 3. 数据结构 ==================== -->
  <DataStructures>
    <Structure name="ClassificationResult">
      <Description>命令分类结果</Description>
      <Fields>
        <Field name="command_type" type="str" required="true">
          <Description>命令类型</Description>
          <ValidValues>SAFE, READ, WRITE, NETWORK, EXEC, UNKNOWN</ValidValues>
        </Field>
        <Field name="risk_level" type="str" required="true">
          <Description>风险等级</Description>
          <ValidValues>minimal, low, medium, high, critical</ValidValues>
        </Field>
        <Field name="matched_patterns" type="List[str]" required="false" default="[]">
          <Description>匹配到的危险模式ID列表</Description>
        </Field>
        <Field name="suggestion" type="Optional[str]" required="false">
          <Description>安全建议或替代方案</Description>
          <Example>建议使用 rm -i 进行交互式删除，避免误删重要文件</Example>
        </Field>
        <Field name="parsed_command" type="ParsedCommand" required="false">
          <Description>解析后的命令结构</Description>
        </Field>
      </Fields>
    </Structure>

    <Structure name="ParsedCommand">
      <Description>解析后的命令结构</Description>
      <Fields>
        <Field name="raw_command" type="str" required="true">
          <Description>原始命令字符串</Description>
        </Field>
        <Field name="commands" type="List[SimpleCommand]" required="true">
          <Description>拆分后的简单命令列表（按管道/分号拆分）</Description>
        </Field>
        <Field name="has_pipe" type="bool" required="false" default="false">
          <Description>是否包含管道</Description>
        </Field>
        <Field name="has_redirection" type="bool" required="false" default="false">
          <Description>是否包含重定向</Description>
        </Field>
        <Field name="has_subshell" type="bool" required="false" default="false">
          <Description>是否包含子shell</Description>
        </Field>
        <Field name="has_command_substitution" type="bool" required="false" default="false">
          <Description>是否包含命令替换（$(...)或`...`）</Description>
        </Field>
      </Fields>
    </Structure>

    <Structure name="SimpleCommand">
      <Description>简单命令（无管道、无重定向的基本命令单元）</Description>
      <Fields>
        <Field name="command" type="str" required="true">
          <Description>命令名（如ls、rm、cat）</Description>
        </Field>
        <Field name="args" type="List[str]" required="false" default="[]">
          <Description>参数列表</Description>
        </Field>
        <Field name="flags" type="List[str]" required="false" default="[]">
          <Description>选项标志列表（如-r、-f）</Description>
        </Field>
      </Fields>
    </Structure>

    <Structure name="DangerPattern">
      <Description>危险模式定义</Description>
      <Fields>
        <Field name="id" type="str" required="true">
          <Description>模式唯一标识</Description>
        </Field>
        <Field name="name" type="str" required="true">
          <Description>模式名称</Description>
        </Field>
        <Field name="pattern" type="str" required="true">
          <Description>匹配正则表达式</Description>
        </Field>
        <Field name="command_type" type="str" required="true">
          <Description>触发该模式的命令类型</Description>
        </Field>
        <Field name="risk_level" type="str" required="true">
          <Description>风险等级</Description>
        </Field>
        <Field name="description" type="str" required="true">
          <Description>模式说明</Description>
        </Field>
        <Field name="suggestion" type="str" required="false">
          <Description>安全建议</Description>
        </Field>
      </Fields>
    </Structure>
  </DataStructures>

  <!-- ==================== 4. 命令类型定义 ==================== -->
  <CommandTypes>
    <Type name="SAFE">
      <Description>只读操作，无任何副作用</Description>
      <Examples>ls, cat, grep, echo, pwd, head, tail, wc, sort, uniq, date, whoami</Examples>
      <RiskLevel>minimal</RiskLevel>
      <Characteristics>
        <Item>不修改文件系统</Item>
        <Item>不访问网络</Item>
        <Item>不执行外部代码</Item>
      </Characteristics>
    </Type>

    <Type name="READ">
      <Description>文件读取操作</Description>
      <Examples>cat, head, less, tail, grep, find, stat, file, md5sum</Examples>
      <RiskLevel>low</RiskLevel>
      <Characteristics>
        <Item>只读取文件内容</Item>
        <Item>不修改文件</Item>
        <Item>可能读取敏感文件（如/etc/passwd）</Item>
      </Characteristics>
    </Type>

    <Type name="WRITE">
      <Description>破坏性写入操作</Description>
      <Examples>rm, mv, cp, dd, mkfs, fdisk, chmod, chown, &gt;, &gt;&gt;</Examples>
      <RiskLevel>medium到high</RiskLevel>
      <Characteristics>
        <Item>修改文件系统</Item>
        <Item>可能删除或覆盖数据</Item>
        <Item>可能修改权限</Item>
      </Characteristics>
    </Type>

    <Type name="NETWORK">
      <Description>网络访问操作</Description>
      <Examples>curl, wget, ssh, scp, nc, telnet, ping, netcat</Examples>
      <RiskLevel>medium到high</RiskLevel>
      <Characteristics>
        <Item>访问外部网络</Item>
        <Item>可能下载恶意代码</Item>
        <Item>可能泄露敏感信息</Item>
      </Characteristics>
    </Type>

    <Type name="EXEC">
      <Description>代码执行操作</Description>
      <Examples>bash, sh, python, perl, ruby, node, eval, exec, source</Examples>
      <RiskLevel>high到critical</RiskLevel>
      <Characteristics>
        <Item>执行外部代码</Item>
        <Item>可能执行恶意脚本</Item>
        <Item>可能获得系统控制权限</Item>
      </Characteristics>
    </Type>
  </CommandTypes>

  <!-- ==================== 5. 风险等级定义 ==================== -->
  <RiskLevels>
    <Level name="minimal">
      <Description>几乎无风险</Description>
      <Examples>ls, pwd, echo, date</Examples>
      <Action>直接执行，无需特殊处理</Action>
    </Level>

    <Level name="low">
      <Description>低风险</Description>
      <Examples>cat, head, grep（读取普通文件）</Examples>
      <Action>直接执行，记录日志</Action>
    </Level>

    <Level name="medium">
      <Description>中等风险</Description>
      <Examples>cp（复制）、mv（移动）、mkdir</Examples>
      <Action>允许执行，建议记录详细日志</Action>
    </Level>

    <Level name="high">
      <Description>高风险</Description>
      <Examples>rm（删除）、chmod、chown、curl、wget、bash</Examples>
      <Action>路由到ConfirmationManager进行二次确认</Action>
    </Level>

    <Level name="critical">
      <Description>极高风险</Description>
      <Examples>rm -rf /, mkfs, dd if=/dev/zero, curl | bash</Examples>
      <Action>直接拒绝，返回安全警告</Action>
    </Level>
  </RiskLevels>

  <!-- ==================== 6. 危险模式库 ==================== -->
  <DangerPatterns>
    <Pattern id="DP-001">
      <Name>强制递归删除根目录</Name>
      <Pattern>rm\s+(-[a-zA-Z]*f[a-zA-Z]*\s+)?(-[a-zA-Z]*r[a-zA-Z]*\s+)?/\s*$|rm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+)?(-[a-zA-Z]*f[a-zA-Z]*\s+)?/\s*$</Pattern>
      <CommandType>WRITE</CommandType>
      <RiskLevel>critical</RiskLevel>
      <Description>尝试删除整个文件系统</Description>
      <Suggestion>此操作极其危险，会删除系统所有文件</Suggestion>
    </Pattern>

    <Pattern id="DP-002">
      <Name>强制递归删除</Name>
      <Pattern>rm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+)(-[a-zA-Z]*f[a-zA-Z]*\s+)</Pattern>
      <CommandType>WRITE</CommandType>
      <RiskLevel>high</RiskLevel>
      <Description>使用-rf强制递归删除，可能误删大量文件</Description>
      <Suggestion>建议使用 rm -i 进行交互式删除</Suggestion>
    </Pattern>

    <Pattern id="DP-003">
      <Name>管道到shell执行</Name>
      <Pattern>curl.*\|\s*(ba)?sh|wget.*\|\s*(ba)?sh|fetch.*\|\s*(ba)?sh</Pattern>
      <CommandType>EXEC</CommandType>
      <RiskLevel>critical</RiskLevel>
      <Description>从网络下载代码并直接执行，极易执行恶意脚本</Description>
      <Suggestion>禁止直接执行网络下载的脚本，请先下载审查</Suggestion>
    </Pattern>

    <Pattern id="DP-004">
      <Name>磁盘格式化</Name>
      <Pattern>mkfs\.|dd\s+if=/dev/zero|dd\s+if=/dev/random|dd\s+if=/dev/urandom</Pattern>
      <CommandType>WRITE</CommandType>
      <RiskLevel>critical</RiskLevel>
      <Description>格式化磁盘或覆盖磁盘数据</Description>
      <Suggestion>此操作会销毁磁盘数据</Suggestion>
    </Pattern>

    <Pattern id="DP-005">
      <Name>远程shell访问</Name>
      <Pattern>ssh\s+.*\s+"|ssh\s+.*\s+'|ssh\s+.*bash|ssh\s+.*sh\s+-c</Pattern>
      <CommandType>NETWORK</CommandType>
      <RiskLevel>high</RiskLevel>
      <Description>通过SSH执行远程命令</Description>
      <Suggestion>确认远程主机和命令的可信度</Suggestion>
    </Pattern>

    <Pattern id="DP-006">
      <Name>网络下载工具</Name>
      <Pattern>curl\s+.*(-o|--output)|wget\s+|fetch\s+</Pattern>
      <CommandType>NETWORK</CommandType>
      <RiskLevel>medium</RiskLevel>
      <Description>从网络下载文件</Description>
      <Suggestion>确认下载来源可信</Suggestion>
    </Pattern>

    <Pattern id="DP-007">
      <Name>权限修改</Name>
      <Pattern>chmod\s+777|chmod\s+-R|chown\s+-R|chmod\s+.*\s+/</Pattern>
      <CommandType>WRITE</CommandType>
      <RiskLevel>high</RiskLevel>
      <Description>修改文件权限，可能暴露敏感文件</Description>
      <Suggestion>谨慎修改权限，避免使用777</Suggestion>
    </Pattern>

    <Pattern id="DP-008">
      <Name>系统命令执行</Name>
      <Pattern>bash\s+-c|sh\s+-c|eval\s+|exec\s+|source\s+|\.\s+</Pattern>
      <CommandType>EXEC</CommandType>
      <RiskLevel>high</RiskLevel>
      <Description>执行外部命令或脚本</Description>
      <Suggestion>确认执行的脚本来源可信</Suggestion>
    </Pattern>

    <Pattern id="DP-009">
      <Name>系统信息探测</Name>
      <Pattern>cat\s+/etc/passwd|cat\s+/etc/shadow|cat\s+/etc/hosts|uname\s+-a|id\s+|whoami</Pattern>
      <CommandType>READ</CommandType>
      <RiskLevel>low</RiskLevel>
      <Description>读取系统敏感信息</Description>
      <Suggestion>注意保护系统信息不被泄露</Suggestion>
    </Pattern>

    <Pattern id="DP-010">
      <Name>子shell和命令替换</Name>
      <Pattern>\$\(.*\)|`.*`|\(.*\)</Pattern>
      <CommandType>EXEC</CommandType>
      <RiskLevel>medium</RiskLevel>
      <Description>使用子shell或命令替换，可能隐藏危险命令</Description>
      <Suggestion>仔细检查子shell中的命令</Suggestion>
    </Pattern>

    <Pattern id="DP-011">
      <Name>进程终止</Name>
      <Pattern>kill\s+-9|killall|pkill</Pattern>
      <CommandType>WRITE</CommandType>
      <RiskLevel>medium</RiskLevel>
      <Description>强制终止进程</Description>
      <Suggestion>确认目标进程，避免误杀系统进程</Suggestion>
    </Pattern>

    <Pattern id="DP-012">
      <Name>环境变量修改</Name>
      <Pattern>export\s+PATH|export\s+LD_PRELOAD</Pattern>
      <CommandType>WRITE</CommandType>
      <RiskLevel>medium</RiskLevel>
      <Description>修改环境变量，可能影响后续命令执行</Description>
      <Suggestion>谨慎修改PATH等关键环境变量</Suggestion>
    </Pattern>
  </DangerPatterns>

  <!-- ==================== 7. 接口定义 ==================== -->
  <Interface>
    <Method name="analyze" visibility="public">
      <Signature>
        <Input>
          <Parameter name="command" type="str" required="true">
            <Description>要分析的Bash命令字符串</Description>
            <Example>ls -la /tmp</Example>
          </Parameter>
          <Parameter name="options" type="dict" required="false" default="{}">
            <Description>分析选项</Description>
            <Fields>
              <Field name="strict_mode" type="bool" default="false">
                <Description>严格模式（提高风险等级一个级别）</Description>
              </Field>
              <Field name="whitelist" type="List[str]" default="[]">
                <Description>允许的命令白名单</Description>
              </Field>
              <Field name="blacklist" type="List[str]" default="[]">
                <Description>禁止的命令黑名单</Description>
              </Field>
            </Fields>
          </Parameter>
        </Input>
        <Output type="ClassificationResult">
          <Description>命令分类和风险评估结果</Description>
        </Output>
      </Signature>
      <Behavior>
        <Step order="0">构建缓存键(command.strip(), _options_key(options))，命中缓存则直接返回</Step>
        <Step order="1">调用_do_analyze执行实际分析</Step>
        <Step order="2">将结果存入缓存并返回ClassificationResult</Step>
      </Behavior>
      <Rules>
        <Rule>包含管道的命令，风险等级取管道中各命令的最高风险</Rule>
        <Rule>管道中存在EXEC类型命令时，风险至少为high</Rule>
        <Rule>包含命令替换（$(...)）时，风险至少为medium</Rule>
        <Rule>严格模式下，所有风险等级提高一级（critical保持critical）</Rule>
        <Rule>若提供whitelist且首命令不在白名单中，直接返回critical/UNKNOWN</Rule>
        <Rule>若提供blacklist且首命令在黑名单中，直接返回critical/UNKNOWN</Rule>
        <Rule>命令长度超过max_command_length限制时，直接返回critical/UNKNOWN</Rule>
      </Rules>
    </Method>

    <Method name="parse_command" visibility="public">
      <Signature>
        <Input>
          <Parameter name="command" type="str" required="true"/>
        </Input>
        <Output type="ParsedCommand">
          <Description>解析后的命令结构</Description>
        </Output>
      </Signature>
      <Description>解析Bash命令的结构元素</Description>
      <Behavior>
        <Step>1. 按管道符(|)和分号(;)拆分命令</Step>
        <Step>2. 识别重定向操作（>, &gt;&gt;, &lt;, &lt;&lt;）</Step>
        <Step>3. 识别子shell（$(...), `...`, (...)）</Step>
        <Step>4. 将每个命令单元解析为SimpleCommand</Step>
        <Step>5. 组装ParsedCommand返回</Step>
      </Behavior>
    </Method>

    <Method name="classify_simple_command" visibility="private">
      <Signature>
        <Input>
          <Parameter name="simple_command" type="SimpleCommand" required="true"/>
        </Input>
        <Output type="str">
          <Description>命令类型（SAFE/READ/WRITE/NETWORK/EXEC）</Description>
        </Output>
      </Signature>
      <Description>根据命令名称分类单个简单命令</Description>
      <ClassificationMap>
        <Map type="SAFE">ls, pwd, echo, date, whoami, hostname, clear, history, alias, unalias</Map>
        <Map type="READ">cat, head, tail, less, more, grep, find, stat, file, md5sum, sha256sum, diff, cmp, strings, objdump, ldd</Map>
        <Map type="WRITE">rm, mv, cp, touch, mkdir, rmdir, dd, mkfs, fdisk, parted, chmod, chown, chgrp, ln, truncate</Map>
        <Map type="NETWORK">curl, wget, ssh, scp, sftp, rsync, nc, netcat, telnet, ftp, ping, traceroute, host, dig, nslookup</Map>
        <Map type="EXEC">bash, sh, zsh, python, python3, perl, ruby, node, php, lua, awk, sed, expect, eval, exec, source</Map>
      </ClassificationMap>
    </Method>

    <Method name="calculate_risk" visibility="private">
      <Signature>
        <Input>
          <Parameter name="parsed_command" type="ParsedCommand" required="true"/>
          <Parameter name="matched_patterns" type="List[str]" required="true"/>
        </Input>
        <Output type="str">
          <Description>风险等级（minimal/low/medium/high/critical）</Description>
        </Output>
      </Signature>
      <Description>计算命令的综合风险等级</Description>
      <Algorithm>
        <Step>1. 初始化风险等级为minimal</Step>
        <Step>2. 遍历所有简单命令，获取每个命令的基础风险</Step>
        <Step>3. 取所有子命令的最高风险作为基础风险</Step>
        <Step>4. 遍历matched_patterns，取所有匹配模式的最高风险</Step>
        <Step>5. 最终风险等级取步骤3和步骤4的较高者</Step>
        <Step>6. 若命令包含管道且其中任一子命令为EXEC，风险至少为high</Step>
        <Step>7. 若命令包含命令替换（$(...)），风险至少为medium</Step>
      </Algorithm>
    </Method>

    <Method name="add_pattern" visibility="public">
      <Signature>
        <Input>
          <Parameter name="pattern" type="DangerPattern" required="true"/>
        </Input>
        <Output type="None"/>
      </Signature>
      <Description>动态添加危险模式</Description>
    </Method>

    <Method name="remove_pattern" visibility="public">
      <Signature>
        <Input>
          <Parameter name="pattern_id" type="str" required="true"/>
        </Input>
        <Output type="bool"/>
      </Signature>
      <Description>移除危险模式</Description>
    </Method>

    <Method name="get_patterns" visibility="public">
      <Signature>
        <Input>
          <Parameter name="risk_level" type="Optional[str]" required="false"/>
        </Input>
        <Output type="List[DangerPattern]"/>
      </Signature>
      <Description>获取危险模式列表（可按风险等级筛选）</Description>
    </Method>

    <Method name="_do_analyze" visibility="private">
      <Signature>
        <Input>
          <Parameter name="command" type="str" required="true"/>
          <Parameter name="options" type="dict" required="true"/>
        </Input>
        <Output type="ClassificationResult"/>
      </Signature>
      <Description>实际执行分析的私有方法，包含白名单/黑名单过滤、严格模式风险升级等逻辑</Description>
      <Behavior>
        <Step>1. 检查命令长度是否超过max_command_length限制</Step>
        <Step>2. 解析命令结构（parse_command）</Step>
        <Step>3. 若提供whitelist，检查首命令是否在白名单中</Step>
        <Step>4. 若提供blacklist，检查首命令是否在黑名单中</Step>
        <Step>5. 分类每个简单命令并计算综合类型</Step>
        <Step>6. 匹配DangerPatterns库</Step>
        <Step>7. 计算综合风险等级（_calculate_risk）</Step>
        <Step>8. 严格模式下风险等级+1（critical除外）</Step>
        <Step>9. 组装ClassificationResult返回</Step>
      </Behavior>
    </Method>

    <Method name="_split_into_segments" visibility="private">
      <Signature>
        <Input>
          <Parameter name="command" type="str" required="true"/>
        </Input>
        <Output type="List[str]"/>
      </Signature>
      <Description>按管道符(|)和分号(;)拆分命令，支持引号保护</Description>
    </Method>

    <Method name="_parse_segment" visibility="private">
      <Signature>
        <Input>
          <Parameter name="segment" type="str" required="true"/>
        </Input>
        <Output type="Optional[SimpleCommand]"/>
      </Signature>
      <Description>解析单个命令片段为SimpleCommand，使用shlex.split处理引号和转义，过滤重定向操作符及其目标</Description>
    </Method>

    <Method name="_options_key" visibility="private" static="true">
      <Signature>
        <Input>
          <Parameter name="options" type="dict" required="true"/>
        </Input>
        <Output type="Tuple[Any, ...]"/>
      </Signature>
      <Description>将options字典转换为可哈希的元组，用于缓存键生成。列表值会被转换为tuple。</Description>
    </Method>
  </Interface>

  <!-- ==================== 8. 命令分类参考表 ==================== -->
  <CommandClassificationReference>
    <Category type="SAFE">
      <Command risk="minimal">ls</Command>
      <Command risk="minimal">pwd</Command>
      <Command risk="minimal">echo</Command>
      <Command risk="minimal">date</Command>
      <Command risk="minimal">whoami</Command>
      <Command risk="minimal">hostname</Command>
      <Command risk="minimal">clear</Command>
      <Command risk="minimal">history</Command>
      <Command risk="minimal">alias</Command>
      <Command risk="minimal">env</Command>
      <Command risk="minimal">printenv</Command>
    </Category>

    <Category type="READ">
      <Command risk="low">cat</Command>
      <Command risk="low">head</Command>
      <Command risk="low">tail</Command>
      <Command risk="low">less</Command>
      <Command risk="low">more</Command>
      <Command risk="low">grep</Command>
      <Command risk="low">find</Command>
      <Command risk="low">stat</Command>
